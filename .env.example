# Copy to .env and adjust. Loaded by your process manager / shell, not the app.

# Redis/Valkey connection Familia operates on.
FAMILIA_URI=redis://127.0.0.1:6379/0

# Base64 of 32 bytes — required in production for encrypted_field.
#   ruby -rbase64 -rsecurerandom -e 'puts Base64.strict_encode64(SecureRandom.bytes(32))'
FAMILIA_ENCRYPTION_KEY=
FAMILIA_KEY_VERSION=v1

# Admin tokens: JSON map of bearer token -> principal.
# Tokens are matched by SHA-256 digest; never logged.
# ADMIN_TOKENS={"s3cret-admin":{"actor":"ops@familia.dev","role":"admin","permissions":["reveal_secrets","repair","run_migrations","raw_command"]},"s3cret-ro":{"actor":"viewer","role":"admin","permissions":[]}}

# CSRF defense-in-depth: comma-separated allowlist of Origins permitted to make
# state-changing requests. Leave empty in dev.
# ADMIN_ALLOWED_ORIGINS=https://admin.example.com

# Set to production to require real tokens + encryption key (no dev fallbacks).
RACK_ENV=development
